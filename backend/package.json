{
  "name": "campus-enroll-backend",
  "version": "1.0.0",
  "description": "Backend API REST & Suite de Tests Logiciels pour la plateforme d'inscription et de paiement aux cours en ligne",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --detectOpenHandles --forceExit",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "cross-env NODE_ENV=test jest tests/e2e --runInBand --detectOpenHandles --forceExit",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1",
    "unleash-client": "^6.12.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 65,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "keywords": [
    "software-testing",
    "tests-logiciels",
    "mysql",
    "express",
    "react",
    "enrollment",
    "payment",
    "jest",
    "supertest"
  ],
  "author": "Bilal - Projet Tests Logiciels EMI",
  "license": "ISC"
}
